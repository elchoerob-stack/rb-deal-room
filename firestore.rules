rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The deal room holds client personal information: FICA references,
    // contact details, offers and transfer history. Nothing here is
    // world-readable. Access is by approved staff only.
    //
    // The door: a person signs in with Google and may leave one request,
    // under their own uid. An admin turns that into a staff document.
    // The first admin is created by hand in the console; after that the
    // admin approves, changes and removes people from inside the app.

    function signedIn() { return request.auth != null; }
    function staffDoc() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function isAdmin() { return isStaff() && staffDoc().data.role == "admin"; }

    // Who may use the app. A person may read their own entry (that is how
    // the app knows it has been let in); an admin may read and manage all.
    match /staff/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.role in ["agent", "principal", "admin"];
      allow delete: if isAdmin() && request.auth.uid != uid;   // nobody removes themselves
    }

    // Waiting at the door. Only your own request, only name and email.
    match /requests/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["name", "email", "ts"]);
      allow read, delete: if isAdmin();
    }

    // The agency's shared workspace: boards, cards, houses and transfers.
    match /ws/{wsId}/{collection}/{docId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.rev is number
        && request.resource.data.keys().hasAll(['rev', 'body']);
      allow delete: if isStaff();
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
